# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas or local connection string for persistent storage.
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/foodgenie?retryWrites=true&w=majority
# Set this as a server-only variable in Vercel. Never use a VITE_ prefix.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/orderit?retryWrites=true&w=majority"

# Server-only Stripe secret key. Use sk_test_... for testing; never expose it in the browser.
STRIPE_SECRET_KEY="sk_test_..."

# Generate a long random value (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Keep this server-only and use the same value across Vercel instances/environments.
SESSION_SECRET="replace-with-a-long-random-secret"

# Public Stripe key used by Stripe.js. This is safe to return from the app's config endpoint.
STRIPE_PUBLISHABLE_KEY="pk_test_..."
